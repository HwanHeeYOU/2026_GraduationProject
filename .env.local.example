DATABASE_URL="file:./prisma/irb_master.db"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# AI 제공자 선택: "luxia" 또는 "anthropic" (기본값: anthropic)
AI_PROVIDER="luxia"

# Luxia
LUXIA_API_KEY="your-luxia-api-key"
LUXIA_MODEL="luxia3-llm-32b-0731"

# Anthropic (AI_PROVIDER=anthropic 사용 시)
ANTHROPIC_API_KEY="your-anthropic-api-key"
