// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects  Project[]
}

model Institution {
  id        String              @id @default(cuid())
  name      String              @unique
  shortName String?
  modules   InstitutionModule[]
  projects  Project[]
}

model IRBModule {
  id                 String              @id @default(cuid())
  name               String
  description        String
  category           String
  isRequired         Boolean             @default(false)
  order              Int
  hasFormula         Boolean             @default(false)
  promptHint         String?
  institutionModules InstitutionModule[]
  projectModules     ProjectModule[]
}

model InstitutionModule {
  id            String      @id @default(cuid())
  institution   Institution @relation(fields: [institutionId], references: [id])
  institutionId String
  module        IRBModule   @relation(fields: [moduleId], references: [id])
  moduleId      String
  priority      Int
  isRequired    Boolean     @default(false)

  @@unique([institutionId, moduleId])
}

model Project {
  id            String          @id @default(cuid())
  name          String
  user          User            @relation(fields: [userId], references: [id])
  userId        String
  institution   Institution     @relation(fields: [institutionId], references: [id])
  institutionId String
  status        String          @default("DRAFT")
  sourceSummary String?
  /// 문항 구조(IRBFormDraftResult: questions + fileSections). 초안 생성 후에도 덮어쓰지 않는다.
  formDraftJson String?
  /// 생성된 초안(IRBFormDraftOutput: sections + rawText)
  draftOutputJson String?
  /// 사용자가 입력한 원본 정보 { userAnswers, naturalLanguageInput } — 재생성/보완 시 근거 자료
  userInputJson String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  modules       ProjectModule[]
  rejectionNotes RejectionNote[]
  templateFiles ProjectTemplateFile[]
}

/// 사용자가 업로드한 기관 양식 원본(HWPX). 내보내기 시 이 양식에 답변을 채워 넣는다.
model ProjectTemplateFile {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  fileName  String
  data      Bytes
  createdAt DateTime @default(now())

  @@unique([projectId, fileName])
}

model ProjectModule {
  id        String    @id @default(cuid())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  module    IRBModule @relation(fields: [moduleId], references: [id])
  moduleId  String
  content   String    @default("")
  order     Int
  updatedAt DateTime  @updatedAt
  rejectionNotes RejectionNote[]

  @@unique([projectId, moduleId])
}

model RejectionNote {
  id            String         @id @default(cuid())
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  projectModule ProjectModule? @relation(fields: [projectModuleId], references: [id], onDelete: Cascade)
  projectModuleId String?
  reason        String
  resolved      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  resolvedAt    DateTime?
}

